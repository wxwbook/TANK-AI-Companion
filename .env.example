# ---- 身份 ----
OWNER_TELEGRAM_ID=123456789
FRIEND_TELEGRAM_IDS=
# Web Office / API 的 Owner 令牌（长随机串，不要提交到仓库）
OWNER_API_TOKEN=change-me-to-a-long-random-string

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Mini App 公网地址（必须 HTTPS，经 NPM 反代）
MINIAPP_URL=

# ---- Hermes Agent API Server（已按官方文档核对）----
# Hermes 侧：~/.hermes/.env 设置 API_SERVER_ENABLED=true 与 API_SERVER_KEY，运行 hermes gateway，默认端口 8642。
# 注意：Hermes API 默认带完整工具集（含终端），务必使用强密钥并只在内网访问。
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_MS=120000
# 好友聊天必须使用“独立的受限 Hermes Profile”（独立端口与密钥，关闭终端/文件等工具）。
# 不配置 = 好友聊天关闭（不会回退到上面的 Owner Hermes）。
HERMES_FRIEND_BASE_URL=
HERMES_FRIEND_API_KEY=
HERMES_FRIEND_MODEL=hermes-agent
CONTEXT_WINDOW_TOKENS=32000

# ---- UnraidClaw（已按其 README 核对：HTTPS 9876，x-api-key 认证）----
# 在 UnraidClaw 设置页生成“专用密钥”，权限预设选 Read Only。
UNRAID_API_URL=https://192.168.1.100:9876
UNRAID_API_KEY=
# 自签证书：推荐固定证书（scripts/fetch-unraid-cert.sh 可抓取），不推荐关闭校验
UNRAID_CA_FILE=
UNRAID_TLS_INSECURE=false

# ---- 审批式运维（默认关闭）----
# 只支持 容器 restart/start/stop，且目标必须在白名单内；每次都需 Owner 审批。
# 注意：UnraidClaw 的权限矩阵看起来是全局的（见 docs/VERIFY.md）。若只有一把密钥，请把 WRITE_API_KEY 设为同一把。
UNRAID_WRITE_ENABLED=false
UNRAID_WRITE_API_KEY=
UNRAID_WRITE_ALLOWLIST=

# ---- 语音中心（OpenAI 兼容接口；可指向本地服务，如 faster-whisper / openedai-speech）----
VOICE_TTS_BASE_URL=
VOICE_TTS_API_KEY=
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICES=alloy,nova
VOICE_STT_BASE_URL=
VOICE_STT_API_KEY=
VOICE_STT_MODEL=whisper-1

# ---- 运行 ----
PORT=8787
HOST=0.0.0.0
DATA_DIR=./data
